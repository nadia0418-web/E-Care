# Gmail SMTP 발신 계정 (앱 비밀번호 필요: https://myaccount.google.com/apppasswords)
GMAIL_SENDER_EMAIL=example@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# HR 이메일 서명에 표시할 GHD 담당자 이름 (선택, 없으면 "담당자"로 표시 → "GHD 담당자"로 렌더링됨)
GHD_STAFF_NAME=담당자

# Supabase (선택 — 설정하면 엑셀/JSON 대신 Supabase를 사용, 미설정 시 로컬 파일로 자동 폴백)
# Project Settings > API Keys 에서 확인. service_role 키는 서버 전용 비밀값이며
# 절대 브라우저/공개 저장소에 노출하지 않는다.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=service_role 비밀 키

# 관리자 로그인 (필수 — 없으면 어떤 아이디/비밀번호로도 로그인 불가)
FLASK_SECRET_KEY=랜덤한 긴 문자열 (세션 서명용, python -c "import secrets; print(secrets.token_hex(32))" 로 생성)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=본인이 정한 비밀번호
